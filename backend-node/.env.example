# ============================================================
# Iconic Estates India — Backend Environment Variables
# Copy this file to .env and fill in your values before start.
# NEVER commit .env to version control.
# ============================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Database Password
DB_NAME=iconic_estates_india

# --- JWT ---
JWT_SECRET=replace_with_a_long_random_secret_string_min_32chars
JWT_EXPIRES_IN=7d

# --- File Uploads ---
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# --- Python Analytics Microservice ---
PYTHON_SERVICE_URL=http://localhost:8000

# --- CORS ---
# Comma-separated list of allowed origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:3000

# --- SMTP (Phase 2 — Email sending from CRM) ---
# If left blank, the "Send Email" API call will fail gracefully and the
# admin panel will fall back to opening the user's own email client (mailto:).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Iconic Estates India
SMTP_FROM_EMAIL=
